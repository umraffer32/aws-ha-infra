# Local .terraform directories
**/.terraform/*

# .tfstate files - can contain secrets in plaintext
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars files - often contain secrets/config
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Plan outputs
*tfplan*

# OS / editor
.DS_Store
.vscode/
.idea/